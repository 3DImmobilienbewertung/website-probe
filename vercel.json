{
  "redirects": [
    {
      "source": "/rnd",
      "destination": "/restnutzungsdauergutachten-hannover.html?utm_source=print&utm_medium=qr&utm_campaign=restnutzungsdauer",
      "permanent": false
    },
    {
      "source": "/zeitung",
      "destination": "/restnutzungsdauergutachten-hannover.html?utm_source=zeitung&utm_medium=print&utm_campaign=restnutzungsdauer",
      "permanent": false
    },
    {
      "source": "/insta",
      "destination": "/restnutzungsdauergutachten-hannover.html?utm_source=instagram&utm_medium=social&utm_campaign=restnutzungsdauer",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
